{
  "uid": "video-processor-apm",
  "title": "Video Processor: APM por serviço",
  "tags": [
    "video-processor",
    "apm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "HTTP (api)",
      "id": 100,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",job=\"$service\"}[5m]))) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",job=\"$service\",status=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",job=\"$service\"}[5m]))) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "type": "stat",
      "title": "p99 latency",
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latência (p50 / p95 / p99)",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate por rota",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",job=\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Status codes ao longo do tempo",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\",job=\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Top 10 rotas mais lentas (p95, 5m)",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m]))))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "type": "row",
      "title": "Consumer SQS (worker; a api consome eventos sem histograma de duração)",
      "id": 101,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": [],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "type": "stat",
      "title": "Mensagens consumidas (msg/s)",
      "id": 102,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(sqs_messages_total{namespace=\"$namespace\",job=\"$service\"}[5m])) or sum(rate(video_inbound_events_total{namespace=\"$namespace\",job=\"$service\"}[5m]))) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de retry, erro ou descarte",
      "id": 103,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(sqs_messages_total{namespace=\"$namespace\",job=\"$service\",result=~\"retry|error|malformed\"}[5m])) or vector(0)) / sum(rate(sqs_messages_total{namespace=\"$namespace\",job=\"$service\"}[5m])) or (sum(rate(video_inbound_events_total{namespace=\"$namespace\",job=\"$service\",result=~\"discarded|failed\"}[5m])) or vector(0)) / sum(rate(video_inbound_events_total{namespace=\"$namespace\",job=\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 tempo de mensagem",
      "id": 104,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sqs_message_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p99 tempo de mensagem",
      "id": 105,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(sqs_message_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo de mensagem (p50 / p95 / p99)",
      "id": 106,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le)(rate(sqs_message_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sqs_message_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(sqs_message_duration_seconds_bucket{namespace=\"$namespace\",job=\"$service\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mensagens por resultado (por segundo)",
      "id": 107,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "noValue": "0"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (result)(rate(sqs_messages_total{namespace=\"$namespace\",job=\"$service\"}[5m])) or sum by (result)(rate(video_inbound_events_total{namespace=\"$namespace\",job=\"$service\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Processo e pods",
      "id": 108,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false,
      "panels": [],
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(go_goroutines{namespace=\"$namespace\",job=\"$service\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memória do processo",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(process_resident_memory_bytes{namespace=\"$namespace\",job=\"$service\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "RSS {{pod}}"
        },
        {
          "expr": "(go_memstats_heap_inuse_bytes{namespace=\"$namespace\",job=\"$service\"}) or vector(0)",
          "refId": "B",
          "legendFormat": "heap in use {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "GC pause (máximo por ciclo)",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(go_gc_duration_seconds{namespace=\"$namespace\",job=\"$service\",quantile=\"1\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU por pod",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$service-.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memória (working set) por pod",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$service-.*\", container!=\"\", container!=\"POD\"})",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Restarts por pod (1h)",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$service-.*\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Réplicas ready vs desired",
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 61
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(kube_deployment_status_replicas_ready{namespace=\"$namespace\", deployment=\"$service\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "ready"
        },
        {
          "expr": "(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=\"$service\"}) or vector(0)",
          "refId": "B",
          "legendFormat": "desired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{namespace=~\"video-processor-.*\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "video-processor-staging",
          "value": "video-processor-staging"
        }
      },
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{namespace=\"$namespace\"}, job)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "video-processor-api",
          "value": "video-processor-api"
        }
      }
    ]
  }
}
